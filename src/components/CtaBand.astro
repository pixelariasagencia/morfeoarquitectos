---
import Media from './Media.astro';
import Button from './Button.astro';
import { img } from '../data/images';
import { contactCta } from '../data/site';
---
<section class="cta dark">
  <div class="cta__bg"><Media img={img.cta} reveal={false} /></div>
  <div class="cta__content">
    <h2 class="t-title" data-reveal="up">¿Qué espacio imaginas?</h2>
    <p class="t-lead" data-reveal="up" style="--d:120">Una casa nueva, una transformación o un espacio para reunir personas: nos interesa conocer tu idea.</p>
    <div data-reveal="up" style="--d:240"><Button href={contactCta.href} label="Iniciar conversación" /></div>
  </div>
</section>

<style>
  .cta { position: relative; isolation: isolate; overflow: hidden; padding: 160px var(--gutter); text-align: center; }
  .cta__bg { position: absolute; inset: -12% 0; z-index: -1; }
  .cta__bg :global(.media-wrap) { height: 100%; }
  .cta__bg::after { content: ''; position: absolute; inset: 0; background: rgb(22 23 20 / 0.55); }
  .cta__content { display: grid; justify-items: center; gap: 20px; max-width: 640px; margin: 0 auto; }
  .cta__content > div { margin-top: 12px; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .cta__bg { animation: cta-parallax linear both; animation-timeline: view(); animation-range: cover; }
      @keyframes cta-parallax { from { transform: translateY(-8%); } to { transform: translateY(8%); } }
    }
  }
  @media (max-width: 809px) { .cta { padding: 112px var(--gutter); } }
</style>
