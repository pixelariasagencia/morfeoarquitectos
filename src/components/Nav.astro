---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { nav, contactCta, contact } from '../data/site';
import { url } from '../data/url';

interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const path = Astro.url.pathname.slice(url('').length).replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="nav" data-nav data-scrolled={solid ? '' : undefined}>
  <div class="nav__inner">
    <a class="logo" href={url('/')} aria-label="Morfeo Arquitectos, inicio">
      <img class="logo__mark" src={url('/brand-mark.svg')} width="32" height="32" alt="" />
      <span class="logo__main">Morfeo</span>
      <span class="logo__sub">Arquitectos</span>
    </a>

    <nav class="nav__links" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="roll"><span>{item.label}</span><span aria-hidden="true">{item.label}</span></span>
            </a><span aria-hidden="true">,</span>
          </li>
        ))}
      </ul>
    </nav>

    <Button class="nav__cta" href={contactCta.href} label={contactCta.label} />

    <button class="nav__menu" type="button" data-menu-open aria-haspopup="dialog">
      <span class="sr-only">Abrir menú</span>
      <Icon name="list" />
    </button>
  </div>
</header>

<dialog class="menu dark" data-menu aria-label="Menú">
  <div class="menu__top">
    <span class="logo"><img class="logo__mark" src={url('/brand-mark.svg')} width="32" height="32" alt="" /><span class="logo__main">Morfeo</span></span>
    <button class="nav__menu" type="button" data-menu-close>
      <span class="sr-only">Cerrar menú</span>
      <Icon name="x" />
    </button>
  </div>
  <ul class="menu__links">
    {nav.map((item, i) => (
      <li style={`--i:${i}`}><a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
    ))}
  </ul>
  <div class="menu__foot">
    <Button href={contactCta.href} label={contactCta.label} />
    <p class="t-soft">{contact.city}</p>
  </div>
</dialog>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    padding: 20px var(--gutter);
    color: var(--marfil);
    transition: padding 500ms var(--ease-out), background-color 500ms var(--ease-out);
  }
  .nav[data-scrolled] { padding: 10px 20px; background: var(--grafito); }
  .nav__inner { position: relative; display: flex; align-items: center; justify-content: space-between; height: 48px; }

  .logo { display: inline-flex; align-items: flex-end; gap: 8px; }
  .logo__mark { width: 32px; height: 32px; margin-right: 3px; flex: none; }
  .logo__main { font-weight: 700; font-size: 1.75rem; line-height: 1; letter-spacing: -0.04em; text-transform: uppercase; }
  .logo__sub { margin-bottom: 3px; font-weight: 600; font-size: 0.625rem; line-height: 1; letter-spacing: 0.24em; text-transform: uppercase; opacity: 0.8; }

  .nav__links { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  .nav__links ul { display: flex; gap: 8px; }
  .nav__links li { display: flex; font-weight: 500; font-size: 1rem; letter-spacing: -0.02em; }
  .nav__links a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }

  .nav__menu {
    display: none; place-items: center; width: 44px; height: 44px; margin-right: -8px;
    border: 0; background: none; color: inherit; cursor: pointer;
  }
  .nav__menu :global(svg) { width: 28px; height: 28px; }

  @media (prefers-reduced-motion: no-preference) {
    .nav { animation: nav-in 900ms var(--ease-out) 150ms both; }
    @keyframes nav-in { from { opacity: 0; transform: translateY(-12px); } }
    .nav :global(.nav__cta) { animation: cta-in 500ms var(--ease-soft) 1200ms both; }
    @keyframes cta-in { from { opacity: 0; transform: translateY(20px); } }
  }

  @media (max-width: 1099px) {
    .nav { padding: 10px var(--gutter); background: var(--grafito); }
    .nav__links, .nav :global(.nav__cta) { display: none; }
    .nav__menu { display: grid; }
  }
  @media (max-width: 380px) {
    .logo__mark { width: 28px; height: 28px; }
    .logo__main { font-size: 1.5rem; }
    .logo__sub { display: none; }
  }

  .menu {
    width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 10px var(--gutter) 32px;
    border: 0; display: flex; flex-direction: column;
  }
  .menu:not([open]) { display: none; }
  .menu::backdrop { background: rgb(22 23 20 / 0.6); }
  .menu__top { display: flex; align-items: center; justify-content: space-between; height: 48px; }
  .menu__top .nav__menu { display: grid; }
  .menu__links { margin-top: auto; display: grid; gap: 4px; }
  .menu__links a { font-weight: 700; font-size: clamp(2.75rem, 12vw, 4.5rem); line-height: 1.05; letter-spacing: -0.04em; text-transform: uppercase; }
  .menu__links a[aria-current='page'] { color: var(--piedra); }
  .menu__foot { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] { animation: menu-in 450ms var(--ease-out); }
    .menu[open] .menu__links li { animation: menu-link 600ms var(--ease-out) both; animation-delay: calc(var(--i) * 50ms + 120ms); }
    @keyframes menu-in { from { opacity: 0; transform: translateY(-16px); } }
    @keyframes menu-link { from { opacity: 0; transform: translateY(24px); } }
  }
</style>
