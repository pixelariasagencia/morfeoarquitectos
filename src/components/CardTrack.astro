---
import MegaType from './MegaType.astro';
import Media from './Media.astro';
import Icon from './Icon.astro';
import type { Img } from '../data/images';

interface Card { title: string; text: string; note?: string; image?: Img }
interface Props { heading: { text: string; align?: 'start' | 'center' | 'end' }[]; items: Card[]; label: string }
const { heading, items, label } = Astro.props;
---
<section class="track dark section" data-track>
  <MegaType lines={heading} />

  <div class="track__controls">
    <button type="button" class="track__btn" data-track-btn><span class="sr-only">Anterior</span><Icon name="arrowLeft" /></button>
    <button type="button" class="track__btn" data-track-btn><span class="sr-only">Siguiente</span><Icon name="arrow" /></button>
  </div>

  <ul class="track__list" data-track-list aria-label={label}>
    {items.map((c, i) => (
      <li class="track__card" data-reveal="up" style={`--d:${i * 90}`}>
        <p class="track__text">{c.text}</p>
        <div class="track__foot">
          {c.image
            ? <Media class="track__thumb" img={c.image} sizes="72px" small reveal={false} />
            : <span class="track__num">({String(i + 1).padStart(2, '0')})</span>}
          <div>
            <h3 class="track__title">{c.title}</h3>
            {c.note && <p class="track__note">{c.note}</p>}
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .track { display: grid; gap: 56px; padding-block: 120px; }
  .track__controls { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: -32px; }
  .track__btn {
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 8px;
    border: 1px solid var(--line-dark); background: none; cursor: pointer;
    transition: transform 160ms var(--ease-out), opacity 200ms ease, background-color 200ms ease;
  }
  .track__btn :global(svg) { width: 20px; height: 20px; }
  .track__btn:active { transform: scale(0.95); }
  .track__btn:disabled { opacity: 0.35; cursor: default; }
  @media (hover: hover) and (pointer: fine) {
    .track__btn:not(:disabled):hover { background: var(--grafito-900); }
  }

  .track__list {
    display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 40px) / 3); gap: 20px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .track__list::-webkit-scrollbar { display: none; }
  .track__card {
    scroll-snap-align: start; min-height: 460px; padding: 40px;
    display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
    background: var(--grafito-900);
  }
  .track__text { font-size: 1.25rem; line-height: 1.3; font-weight: 450; }
  .track__foot { display: flex; align-items: center; gap: 16px; }
  .track__foot :global(.track__thumb) { width: 64px; height: 64px; flex: none; }
  .track__num { font-weight: 700; font-size: 1.125rem; color: var(--piedra); }
  .track__title { font-weight: 700; font-size: 1.125rem; letter-spacing: -0.02em; }
  .track__note { margin-top: 4px; font-weight: 500; font-size: 1rem; color: var(--on-dark-soft); }

  @media (max-width: 1099px) {
    .track__list { grid-auto-columns: calc((100% - 20px) / 2); }
  }
  @media (max-width: 809px) {
    .track { padding-block: 80px; gap: 40px; }
    .track__list { grid-auto-columns: 86%; }
    .track__card { min-height: 380px; padding: 28px; }
    .track__controls { margin-bottom: -16px; }
  }
</style>
