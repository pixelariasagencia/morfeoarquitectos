---
import arrow from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowLeft from '@phosphor-icons/core/assets/regular/arrow-left.svg?raw';
import list from '@phosphor-icons/core/assets/regular/list.svg?raw';
import x from '@phosphor-icons/core/assets/regular/x.svg?raw';
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw';
import phone from '@phosphor-icons/core/assets/regular/phone.svg?raw';
import mail from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';
import pin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import image from '@phosphor-icons/core/assets/regular/image.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check-circle.svg?raw';

const icons = { arrow, arrowLeft, list, x, plus, phone, mail, pin, image, check };
interface Props { name: keyof typeof icons; class?: string }
const { name, class: className } = Astro.props;
---
<Fragment set:html={icons[name].replace('<svg ', `<svg aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''} `)} />
